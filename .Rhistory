knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(lme4)
library(lmerTest)
data <- read_csv("../data/processed/data.csv")
data
cm <- lmer(lf_count_log ~ narr_freq_log + else_freq_log + (1|lang) + (1|field), data)
summary(cm)
em <- lmer(lf_entropy ~ narr_freq_log + else_freq_log + (1|lang) + (1|field), data)
summary(em)
library(report)
install.packages
install.packages("report")
library(report)
report(cm)
drop1(bio.lmer2, test = "F")
drop1(cm, test = "F")
drop1(cm, test = "T")
drop1(cm, test = "T")
drop1(cm, test = "F")
report(cm, em)
report(em)
ggpredict(cm, terms = c("narr_freq_log", "else_freq_log"), type = "random") %>%
plot(., add.data = TRUE)
library(ggeffects)
install.packages(ggeffects)
install.packages('ggeffects')
library(ggeffects)
ggpredict(cm, terms = c("narr_freq_log", "else_freq_log"), type = "random") %>%
plot(., add.data = TRUE)
ggpredict(cm, terms = c("field", "lang"), type = "random") %>%
plot(., add.data = TRUE)
ggpredict(cm, terms = c("field", "lang"), type = "random") %>% plot(., add.data = TRUE)
ggpredict(cm, terms = c("field", "lang"), type = "random") %>% plot(., add.data = T)
ggpredict(cm, terms = c("field", "lang"), type = "random") %>% plot(.)
ggpredict(cm, terms = c("narr_freq_log", "lang"), type = "random") %>% plot(.)
ggpredict(cm, terms = c("narr_freq_log", "field"), type = "random") %>% plot(.)
ggpredict(cm, terms = c("lang", "ggeffects"), type = "random") %>% plot(.)
ggpredict(cm, terms = c("lang", "narr_freq_log"), type = "random") %>% plot(.)
ggpredict(cm, terms = c("narr_freq_log", "narr_freq_log"), type = "random") %>% plot(.)
ggpredict(cm, terms = c("narr_freq_log", "lang"), type = "random") %>% plot(.)
ggpredict(cm, terms = c("narr_freq_log", "lang", "field"), type = "random") %>% plot(.)
ggpredict(cm, terms = c("narr_freq_log"), type = "random") %>% plot(.)
ggpredict(cm, terms = c("narr_freq_log", "else_freq_log"), type = "random") %>% plot(.)
ggpredict(cm, terms = c("narr_freq_log", "else_freq_log"), type = "fixed") %>% plot(.)
ggpredict(cm, terms = c("narr_freq_log"), type = "fixed") %>% plot(.)
ggpredict(cm, terms = c("narr_freq_log"), type = "fixed") %>% ggpredict(cm, terms = c("else_freq_log"), type = "fixed") %>% plot(.)
report(cm)
report(em)
anova(cm)
drop1(cm, test = "F")
vcov(cm)
plot(vcov(cm))
vcov(cm)
cov2cor(vcov(cm))
cov2cor(vcov(em))
cov2cor(vcov(em))
cov2cor(vcov(cm))
cov2cor(vcov(em))
